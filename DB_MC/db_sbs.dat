-------[ 2024-09-01 00:00:00 ] # start GEP:

# FT origin is 16.5 cm above beam height
sbs.gemorigin_xyz = -0.165 0.0 3.6814
sbs.gemangles_xyz = 0 0 0

sbs.optics_origin = 0.0 0.0 3.6814

sbs.polarimetermode = 1

# the following parameters control the constraint point definitions in either the back-to-front or front-to-back algorithms. So far, they
# don't affect anything else:
# Z of midpoint of CH2 analyzer:
sbs.z0analyzer = 1.518
#sbs.analyzerthick = 0.5588 # NOTE 55.88 cm is the physical thickness of the CH2 from drawings
sbs.analyzerthick = 0.62 # setting to 0.62 adds roughly 3 cm tolerance at both ends beyond physical CH2 thickness; affects behavior of both front-to-back and back-to-front algorithms
sbs.sigmazclose = 0.002 # this will also add (5 * 0.002 m = 1 cm )/ sin(theta) tolerance to zclose when populating the list of "good" constraint point pairs when using the "back-to-front" algorithm. As of now, this parameter does not affect the behavior of the front-to-back algorithm (or anything else)

sbs.nbinsz_fcp = 11 # number of bins to divide the physical extent of the CH2 analyzer in the front-to-back algorithm

# test GEP tracking mode:
sbs.geptrackingmode = 1       
#sbs.geptrackingflag = 0 # flag 0 (1) = FT (FPP) first, use FT (FPP) to define FPP (FT) constraint
sbs.geptrackingflag = 1

sbs.optics_order = 4

# AJRP 10/8/2026: new 4th-order fits to forward and backward optics. 

# number of nonzero terms = 
#70
# total number of terms = 126
# Expansion is: u = sum_{i,j,k,l,m}=0^{i+j+k+l+m<=order} Cu_{ijklm} xfp^i * yfp^j * xpfp^k * ypfp^l * xtar^m, 
# u = xptar, yptar, ytar, p*thetabend. Columns are:
#          Cxptar          Cyptar           Cytar     Cpthetabend   i j k l m

