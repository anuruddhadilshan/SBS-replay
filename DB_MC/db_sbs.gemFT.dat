############### Parameters searched by SBSGEMSpectrometerTracker::ReadDatabase() ######################
# Parameters controlling 1D clustering and 2D hit finding (updating for replay with background)
sbs.gemFT.useopticsconstraint = 1
sbs.gemFT.ADCasym_cut = 0.8 
sbs.gemFT.deltat_cut = 25.0
sbs.gemFT.corrcoeff_cut = 0.5

sbs.gemFT.peakprominence_minsigma = 2.0
sbs.gemFT.peakprominence_minfraction = 0.1
# change to "soft hit filtering:
sbs.gemFT.filterflag1D = -1 # -1 = no filtering: don't require 1D hits to pass any cuts other than basic zero suppression
sbs.gemFT.filterflag2D = -1  # 1 = "hard" filtering: require 2D hits to pass all cuts

sbs.gemFT.use_enhanced_chi2 = 1
sbs.gemFT.trackchi2cut_hitquality = 12.0

# Parameters controlling tracking:
sbs.gemFT.minhitsontrack = 4

sbs.gemFT.maxhitcombos = 25000 
sbs.gemFT.maxhitcombos_inner = 25000 
sbs.gemFT.maxhitcombos_total = 1.e24

sbs.gemFT.gridbinwidthx = 0.005
sbs.gemFT.gridbinwidthy = 0.005
sbs.gemFT.gridedgetolerancex = 0.0015
sbs.gemFT.gridedgetolerancey = 0.0015


sbs.gemFT.efficiency_bin_width_1D = 0.02
sbs.gemFT.efficiency_bin_width_2D = 0.04
sbs.gemFT.do_efficiencies = 1

sbs.gemFT.trackchi2cut = 15 20 25 30 40

sbs.gemFT.suppressfirstlast = -1


# =============================================================================
# FT MC INPUT / CALIBRATION PROFILES
# =============================================================================
# Enable exactly ONE complete profile below by commenting/uncommenting its
# assignment lines. PROFILE A is active; PROFILE B is initially commented out.
# To replay legacy full readout: comment ALL assignments in A, then uncomment
# ALL assignments in B, including every module's CM and strip-noise entries.
# To return to new digitization: reverse those changes for the ENTIRE blocks.
# Do not leave legacy CM arrays active with A: they can prevent cmfile loading.
# Earlier default input settings near the top are overridden by these profiles.
# Geometry, clustering, tracking and the shared settings below apply to both.
#
# Input modes describe processing, not the age of the digitizer:
#   0: historical ZS MC interface
#   1: online CM subtraction + online ZS
#   2: online CM subtraction, full readout
#   3: raw full readout; replay calculates/subtracts CM
# Both the new raw/full sample and the legacy fixed-CM/full sample use mode 3.
# =============================================================================

# Shared readout-channel and sorting configuration:
sbs.gemFT.chan_cm_flags = 640
sbs.gemFT.commonmode_nstriplo = 10
sbs.gemFT.commonmode_nstriphi = 50
#sbs.gemFT.commonmode_minstrips = 5
#sbs.gemFT.tryfasttrack = 0
sbs.gemFT.do_goodADC_tracking = 1

# ---------------- BEGIN PROFILE A: NEW DIGITIZATION (ACTIVE) ------------------
# Per-strip RMS and per-APV CM calibration come from the digitizer calibration.
# The existing mode-3 configuration is retained. For modes 1 or 2, change
# mc_input_mode to describe the actual input; it sets the online ZS state.
sbs.gemFT.pedfile = gemped/ft_mc_pedestal_rms.dat
sbs.gemFT.cmfile = gemped/ft_mc_commonmode.dat
sbs.gemFT.mc_input_mode = 3
sbs.gemFT.commonmode_flag = 0
sbs.gemFT.correct_common_mode = 0
# Preserved existing flag: mode 3 overrides it to false (full readout).
sbs.gemFT.onlinezerosuppress = 1
sbs.gemFT.zerosuppress = 1
sbs.gemFT.pedsub_online = 1
sbs.gemFT.pedestalmode = 0
# Optional CM diagnostics for new digitization; enable when needed:
# sbs.gemFT.plot_common_mode = 1
# ------------------------- END PROFILE A -------------------------------------

# ------------- BEGIN PROFILE B: LEGACY FULL READOUT (COMMENTED) ---------------
# Requires digitized samples with no online ZS and no online CM subtraction.
# True injected CM is fixed at 1500 ADC: its physical fluctuation RMS is ZERO.
# Strip noise is independent, sigma=20 ADC/sample; average-of-six RMS=20/sqrt(6).
# No pedfile/cmfile assignments belong in this profile. Disable A completely.
# Pedestal means below are zero: replay removes the 1500 baseline as measured CM.
# commonmode_meanU/V provide references for the auxiliary diagnostic estimators.
# commonmode_rmsU/V=10 is their POSITIVE SEARCH WIDTH (existing replay default),
# NOT the injected CM fluctuation RMS; it adds no noise or fluctuations to MC.
# Sorting calculates the actual CM from the samples and does not need that width.
# Setting the diagnostic width to zero breaks the current histogram CM method.
# Every CM array has one entry per APV, in physical strip-position order.
# Uncomment ALL assignment lines in this block together.
# -----------------------------------------------------------------------------
# sbs.gemFT.mc_input_mode = 3
# sbs.gemFT.commonmode_flag = 0
# sbs.gemFT.correct_common_mode = 0
# sbs.gemFT.onlinezerosuppress = 0
# sbs.gemFT.zerosuppress = 1
# sbs.gemFT.pedestalmode = 0
# sbs.gemFT.pedsub_online = 1
# sbs.gemFT.plot_common_mode = 1

