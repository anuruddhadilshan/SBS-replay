#angles
# the "U" angle should be -30 + 180 degrees or -30 - 180 degrees = 150 or -210 degrees
# the "V" angle should be 30 - 180 degrees or 30 + 180 degrees = 210 or -150 degrees

# In digitized X/W layers, the x strips run from negative to positive X
# W strips measure (X+Y)/sqrt(2) (in layer 0) and (X-Y)/sqrt(2) (in layer 1)
# u = cos(uangle)*x + sin(uangle)*y 
# v = cos(vangle)*x + sin(vangle)*y (seems angles are correct!)
# for u/v layers:
# it seems the "U" measures x * cos(30 deg) - y * sin(30 deg)
# and "V" measures x * cos(30 deg) + y * sin( 30 deg)
# so these angles look correct too. Must be the "chanmap" thing, probably related to the assertion error, checking tomorrow
sbs.gemFT.m0.uangle = 0.0
sbs.gemFT.m0.vangle = 45.0
sbs.gemFT.m1.uangle = 0.0
sbs.gemFT.m1.vangle = -45.0
sbs.gemFT.m2.uangle = 330.0
sbs.gemFT.m2.vangle = 30.0
sbs.gemFT.m3.uangle = 330.0
sbs.gemFT.m3.vangle = 30.0
sbs.gemFT.m4.uangle = 330.0
sbs.gemFT.m4.vangle = 30.0
sbs.gemFT.m5.uangle =  330.0
sbs.gemFT.m5.vangle = 30.0

# for the UVA X/Y modules the "X" axis coincides with the direction of transport coordinates but the "Y" axis is opposite the direction of transport coordinates:
